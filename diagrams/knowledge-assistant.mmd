flowchart LR
    employee[Employee] --> sso[Company SSO]
    employee --> ui[Assistant UI]
    sso --> api[API and access control]
    ui --> api
    api --> orchestrator[Orchestrator]
    orchestrator --> retrieval[Permission-filtered retrieval]
    retrieval --> index[(Search index)]
    orchestrator --> gateway[Model gateway]
