    orchestrator --> gate[Citation and response gate]
    gate --> ui
    owner[Document owner] --> source[(Approved policy source)]
    source --> ingest[Ingestion and versioning]
    ingest --> index
    api --> audit[(Audit and metrics)]
    orchestrator --> audit
